---
layout: base.njk
title: Steel Reuse & Recycling
description: Circular Steel is the leading industry platform dedicated to advancing the reuse of structural steel.
---
{% from "sponsor-grid.njk" import sponsorGrid %}
<div class="hero hero-photo">
  <div class="wrap">
    <div class="hero-grid">
      <div class="hero-copy">
        <h1>{{ pages.home.heroTitle }}</h1>
        <p class="lede">{{ pages.home.heroLede }}</p>
        <div class="btn-row">
          <a class="btn on-dark solid-white" href="/uk/">Circular Steel UK</a>
          <a class="btn on-dark solid-white" href="/usa/">Circular Steel USA</a>
        </div>
      </div>
      <div class="media-frame video" id="hero-video" data-yt="W3pWW-oixjE" style="cursor:pointer; background-image:url('https://img.youtube.com/vi/W3pWW-oixjE/hqdefault.jpg'); background-size:cover; background-position:center;">
        <span class="play-btn" aria-hidden="true">
          <svg width="22" height="22" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <div class="caption">Circular Steel UK 2026 highlights &middot; click to play</div>
      </div>
      <script>
        document.getElementById('hero-video').addEventListener('click', function () {
          var id = this.dataset.yt;
          this.innerHTML = '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0" title="Circular Steel highlights" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
          this.style.backgroundImage = 'none';
          this.style.cursor = 'default';
        });
      </script>
    </div>
  </div>
</div>

<section>
  <div class="wrap prose">
    <p>{{ pages.home.introText }}</p>
  </div>
</section>

<section class="dark">
  <div class="wrap">
    <div class="grid-4">
      <div class="stat">
        <div class="number">{{ collections.events.length }}</div>
        <div class="label">Events held since 2022</div>
      </div>
      <div class="stat">
        <div class="number">125+</div>
        <div class="label">At our biggest UK event yet, 2026</div>
      </div>
      <div class="stat">
        <div class="number">{{ collections.sponsors.length }}</div>
        <div class="label">Sponsor organisations in the community</div>
      </div>
      <div class="stat">
        <div class="number">UK &amp; USA</div>
        <div class="label">And growing</div>
      </div>
    </div>
  </div>
</section>

{% set globalPartners = programmePartners.global | resolveSponsors(collections.sponsors, collections.tiers) %}
{% if globalPartners.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Backed by</span>Our Sponsors</h2>
    <div class="grid-3">
      {{ sponsorGrid(globalPartners, collections.tiers) }}
    </div>
  </div>
</section>
{% endif %}

<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">What's next</span>Future events</h2>
    <div class="grid-2">
      <div class="card">
        <div class="meta">UK &middot; 23 June 2027</div>
        <h3>Circular Steel UK 2027</h3>
        <p>London. More info coming soon &mdash; if you want to be involved, get in touch.</p>
      </div>
      <div class="card">
        <div class="meta">USA &middot; 15&ndash;16 April 2027</div>
        <h3>Circular Steel USA 2027</h3>
        <p>Denver, CO. More info coming soon &mdash; if you want to be involved, get in touch.</p>
      </div>
    </div>
  </div>
</section>

<section class="wash">
  <div class="wrap">
    <div class="split">
      <div>
        <h2 class="section-title"><span class="kicker">Why it matters</span>{{ pages.home.whyMattersHeading }}</h2>
        <p style="color:var(--muted); font-size:16px;">{{ pages.home.whyMattersBody1 }}</p>
        <p style="color:var(--muted); font-size:16px;"><strong style="color:var(--ink);">A platform built around action.</strong> {{ pages.home.whyMattersBody2 }}</p>
      </div>
      <div class="split-media media-frame">
        <img src="/images/gallery/2024-stage.jpg" alt="Circular Steel UK 2024 &mdash; keynote session">
      </div>
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <div class="split reverse">
      <div>
        <h2 class="section-title"><span class="kicker">Two series</span>UK &amp; USA</h2>
        <p style="color:var(--muted); font-size:16px; margin-bottom:10px;">{{ pages.home.twoSeriesUkText }}</p>
        <p style="color:var(--muted); font-size:16px;">{{ pages.home.twoSeriesUsaText }}</p>
        <div class="btn-row" style="justify-content:flex-start;">
          <a class="btn" href="/uk/">Visit Circular Steel UK</a>
          <a class="btn" href="/usa/">Visit Circular Steel USA</a>
        </div>
      </div>
      <div class="split-media media-frame">
        <img src="/images/gallery/2025-usa-workshop.jpg" alt="Circular Steel USA 2025 &mdash; workshop session">
      </div>
    </div>
  </div>
</section>

<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Six years running</span>Moments from past events</h2>
    <div class="gallery">
      <a class="g-a" href="/uk/2026/"><img src="/images/gallery/2026-uk-speaker.jpg" alt="Circular Steel UK 2026"></a>
      <a href="/uk/2024/"><img src="/images/gallery/2024-stage.jpg" alt="Circular Steel UK 2024"></a>
      <a href="/usa/2025/"><img src="/images/gallery/2025-usa-workshop.jpg" alt="Circular Steel USA 2025"></a>
      <a class="g-b" href="/uk/2023/"><img src="/images/gallery/2023-networking.jpg" alt="Circular Steel UK 2023"></a>
      <a href="/uk/2025/"><img src="/images/gallery/2025-uk-roundtable.jpg" alt="Circular Steel UK 2025"></a>
      <a href="/uk/2022/"><img src="/images/gallery/2022-networking.jpg" alt="Circular Steel UK 2022"></a>
    </div>
  </div>
</section>

{% set logoSponsors = collections.sponsors | withLogo %}
{% if logoSponsors.length %}
<section>
  <div class="wrap" style="text-align:center;">
    <h2 class="section-title" style="text-align:center;">
      <span class="kicker">Community</span>
      Sponsors across the steel supply chain
    </h2>
    {% set logoRows = logoSponsors | splitInHalf %}
    {% set row1 = logoRows[0] | marqueeRow %}
    {% set row2 = logoRows[1] | marqueeRow %}
    <div class="logo-marquee">
      <div class="logo-marquee-row">
        <div class="logo-marquee-track" style="--repeat-count: {{ row1.repeats }};">
          {% for s in row1.items %}
          <a class="logo-tile" href="{{ s.url }}" title="{{ s.data.title }}">
            <img src="{{ s.data.logo }}" alt="{{ s.data.title }}">
          </a>
          {% endfor %}
        </div>
      </div>
      <div class="logo-marquee-row reverse">
        <div class="logo-marquee-track" style="--repeat-count: {{ row2.repeats }};">
          {% for s in row2.items %}
          <a class="logo-tile" href="{{ s.url }}" title="{{ s.data.title }}">
            <img src="{{ s.data.logo }}" alt="{{ s.data.title }}">
          </a>
          {% endfor %}
        </div>
      </div>
    </div>
  </div>
</section>
{% endif %}

{% set playbookPartners = programmePartners.playbook | resolveSponsors(collections.sponsors, collections.tiers) %}
{% if playbookPartners.length %}
<section class="dark" style="background: var(--navy-deep);">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Also from us</span>Reuse Playbook</h2>
    <p style="color:rgba(255,255,255,0.82); font-size:16px; margin-bottom:24px; max-width:70ch;">Our practical guide to specifying and delivering reused steel, backed by its own sponsors. Reuse Playbook has a home of its own at <a href="https://reuseplaybook.com" target="_blank" rel="noopener" style="color:#fff;">reuseplaybook.com</a>.</p>
    <div class="grid-3">
      {{ sponsorGrid(playbookPartners, collections.tiers) }}
    </div>
  </div>
</section>
{% endif %}

<section class="dark" style="border-top: 1px solid rgba(255,255,255,0.12);">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">The newsletter</span>Latest from Circular Steel on Substack</h2>
    {% if substackPosts.length %}
    <div class="grid-3 tiles-sm">
      {% for post in substackPosts %}
      <a class="post-tile" href="{{ post.link }}" target="_blank" rel="noopener">
        {% if post.image %}
        <div class="thumb"><img src="{{ post.image }}" alt="" loading="lazy"></div>
        {% endif %}
        <div class="body">
          <div class="meta">{{ post.pubDate | niceDate }}</div>
          <h3>{{ post.title }}</h3>
          <p>{{ post.description }}</p>
        </div>
      </a>
      {% endfor %}
    </div>
    {% endif %}
    <div style="text-align:center; margin-top:32px;">
      <a class="btn on-dark solid-white" href="{{ site.substack }}" target="_blank" rel="noopener">Subscribe on Substack</a>
    </div>
  </div>
</section>
