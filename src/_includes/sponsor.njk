---
layout: base.njk
---
{% if featured and heroImage %}
<section class="hero hero-photo" style="padding-bottom:0; --hero-img: url('{{ heroImage }}'); --hero-pos: center;">
  <div class="wrap">
    {% if logo %}
    <div class="logo-tile large" style="margin: 0 auto 20px; background: #fff;">
      <img src="{{ logo }}" alt="{{ title }}">
    </div>
    {% endif %}
    <h1>{{ title }}</h1>
  </div>
</section>
{% else %}
<section class="hero" style="padding-bottom:0;">
  <div class="wrap">
    {% if logo %}
    <div class="logo-tile large" style="margin: 0 auto 20px;">
      <img src="{{ logo }}" alt="{{ title }}">
    </div>
    {% endif %}
    <h1>{{ title }}</h1>
  </div>
</section>
{% endif %}

<section>
  <div class="wrap prose">
    {{ content | safe }}

    {% if contacts and contacts.length %}
    <h2>Contacts</h2>
    <ul>
      {% for c in contacts %}
      <li>{{ c.name }}{% if c.role %} &mdash; {{ c.role }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if website %}
    <p><a class="btn" href="{{ website }}" target="_blank" rel="noopener">Visit website &rarr;</a></p>
    {% endif %}
  </div>
</section>

{% if featured and gallery and gallery.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Gallery</span>More from {{ title }}</h2>
    <div class="photo-gallery">
      {% for g in gallery %}
      <figure>
        <img src="{{ g.image }}" alt="{{ g.caption or title }}">
        {% if g.caption %}<figcaption>{{ g.caption }}</figcaption>{% endif %}
      </figure>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set history = collections.events | eventsForSponsor(slug) %}
{% if history.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Sponsorship history</span>Events supported</h2>
    <div class="grid-3">
      {% for row in history %}
      <a class="card-link" href="{{ row.event.url }}">
        <div class="card tier-ribbon" style="--tc1: {{ row.tier | tierColor(collections.tiers) }}; --tc2: {{ row.tier | tierColor2(collections.tiers) }};">
          <div class="ribbon"><span>{{ row.tier | displayTier }}</span></div>
          <div class="body">
            <div class="meta">{{ row.event.data.year }}</div>
            <h3>{{ row.event.data.title }}</h3>
            {% if row.note %}<p>{{ row.note }}</p>{% endif %}
          </div>
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
