---
layout: base.njk
---
<section class="hero" style="padding-bottom:0;">
  <div class="wrap">
    {% if logo %}
    <div class="logo-tile large" style="margin: 0 auto 20px;">
      <img src="{{ logo }}" alt="{{ title }}">
    </div>
    {% endif %}
    <h1>{{ title }}</h1>
  </div>
</section>

<section>
  <div class="wrap prose">
    {{ content | safe }}

    {% if contacts and contacts.length %}
    <h2>Contacts</h2>
    <ul>
      {% for c in contacts %}
      <li>{{ c.name }}{% if c.role %} &mdash; {{ c.role }}{% endif %}</li>
      {% endfor %}
    </ul>
    {% endif %}

    {% if website %}
    <p><a class="btn" href="{{ website }}" target="_blank" rel="noopener">Visit website &rarr;</a></p>
    {% endif %}
  </div>
</section>

{% set history = collections.events | eventsForSponsor(slug) %}
{% if history.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Sponsorship history</span>Events supported</h2>
    <div class="grid-3">
      {% for row in history %}
      <a class="card-link" href="{{ row.event.url }}">
        <div class="card tier-edge" style="--tier-color: {{ row.tier | tierColor(collections.tiers) }};">
          <span class="tag tier-dynamic" style="--tier-color: {{ row.tier | tierColor(collections.tiers) }};">{{ row.tier }}</span>
          <div class="meta" style="margin-top:10px;">{{ row.event.data.year }}</div>
          <h3>{{ row.event.data.title }}</h3>
          {% if row.note %}<p>{{ row.note }}</p>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}
