---
layout: base.njk
---
<section class="hero" style="padding-bottom:0;">
  <div class="wrap">
    <span class="tag {{ 'status-past' if status == 'past' }}">{{ status | upper }}</span>
    <h1 style="margin-top:14px;">{{ title }}</h1>
    <p class="lede">
      {% if date %}{{ date }}{% endif %}
      {% if venue %} &middot; {{ venue }}{% endif %}
    </p>
  </div>
</section>

<section>
  <div class="wrap prose">
    {{ content | safe }}
  </div>
</section>

{% set eventSponsors = sponsors | resolveSponsors(collections.sponsors) %}
{% if eventSponsors.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Thank you</span>Sponsors</h2>
    <div class="grid-3">
      {% for s in eventSponsors %}
      <a class="card-link" href="{{ s.profile.url }}">
        <div class="card">
          {% if s.profile.data.logo %}
          <div class="logo-tile" style="margin-bottom:14px;">
            <img src="{{ s.profile.data.logo }}" alt="{{ s.profile.data.title }}">
          </div>
          {% endif %}
          <div class="meta">{{ s.tier }}</div>
          <h3>{{ s.profile.data.title }}</h3>
          {% if s.note %}<p>{{ s.note }}</p>{% endif %}
        </div>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% if downloads and downloads.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Downloads</span>From the day</h2>
    <div class="doc-grid">
      {% for d in downloads %}
      {% if d.url %}
      <a class="doc-card is-live" href="{{ d.url }}" target="_blank" rel="noopener">
      {% else %}
      <span class="doc-card is-pending">
      {% endif %}
        <span class="doc-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <span>
          <span class="doc-title">{{ d.label }}</span>
          <span class="doc-sub">{% if d.url %}Download PDF{% else %}Link pending{% endif %}</span>
        </span>
      {% if d.url %}</a>{% else %}</span>{% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

<section>
  <div class="wrap" style="text-align:center;">
    <a class="btn" href="/{{ region }}/">&larr; Back to Circular Steel {{ region | upper }}</a>
  </div>
</section>
