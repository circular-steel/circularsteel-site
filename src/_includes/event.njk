---
layout: base.njk
---
{% from "sponsor-grid.njk" import sponsorGrid %}
<section class="hero{% if heroImage %} hero-photo hero-center{% endif %}" style="{% if heroImage %}--hero-img: url('{{ heroImage }}'); --hero-pos: center;{% else %}padding-bottom:0;{% endif %}">
  <div class="wrap">
    <span class="tag {{ 'status-past' if status == 'past' }}">{{ status | upper }}</span>
    <h1 style="margin-top:14px;">{{ title }}</h1>
    <p class="lede">{% if date %}{{ date | eventDate }}{% endif %}{% if time %}, {{ time }}{% endif %}{% if venue %} &middot; {{ venue }}{% endif %}</p>
    {% if ctaLabel and ctaUrl %}
    <p style="margin-top:22px;"><a class="btn {{ 'on-dark solid-white' if heroImage else 'solid' }}" href="{{ ctaUrl }}">{{ ctaLabel }}</a></p>
    {% endif %}
  </div>
</section>

<section>
  <div class="wrap prose">
    {{ content | safe }}
  </div>
</section>

{% set eventSponsors = sponsors | resolveSponsors(collections.sponsors, collections.tiers) %}
{% if eventSponsors.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Thank you</span>Sponsors</h2>
    <div class="grid-3">
      {{ sponsorGrid(eventSponsors, collections.tiers) }}
    </div>
  </div>
</section>
{% endif %}

{% if videos and videos.length %}
<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Watch</span>{{ videos_title or "More from the day" }}</h2>
    <div class="video-grid">
      {% for v in videos %}
      <div class="video-tile" data-yt="{{ v.id }}" style="background-image:url('https://img.youtube.com/vi/{{ v.id }}/hqdefault.jpg');">
        <span class="play-btn small" aria-hidden="true">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="#fff"><path d="M8 5v14l11-7z"/></svg>
        </span>
        <span class="video-label">{{ v.label }}</span>
      </div>
      {% endfor %}
    </div>
  </div>
</section>
<script>
  document.querySelectorAll('.video-tile[data-yt]').forEach(function (tile) {
    tile.addEventListener('click', function () {
      var id = this.dataset.yt;
      this.innerHTML = '<iframe src="https://www.youtube.com/embed/' + id + '?autoplay=1&rel=0" allow="autoplay; encrypted-media" allowfullscreen></iframe>';
      this.style.backgroundImage = 'none';
    });
  });
</script>
{% endif %}

{% if downloads and downloads.length %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Downloads</span>From the day</h2>

    {% if download_style == "tile" %}
    <div class="doc-tile-grid">
      {% for d in downloads %}
      {% if d.url %}
      <a class="doc-tile is-live" href="{{ d.url }}" target="_blank" rel="noopener">
      {% else %}
      <span class="doc-tile is-pending">
      {% endif %}
        <span class="doc-tile-head" style="{% if d.color %}--accent-color: {{ d.color }};{% endif %}">
          <span class="doc-title">{{ d.label }}</span>
        </span>
        <span class="doc-tile-body">
          <span class="doc-sub">{% if d.url %}Download PDF{% else %}Link pending{% endif %}</span>
          {% if d.description %}<span class="doc-desc">{{ d.description }}</span>{% endif %}
        </span>
      {% if d.url %}</a>{% else %}</span>{% endif %}
      {% endfor %}
    </div>
    {% else %}
    <div class="doc-grid">
      {% for d in downloads %}
      {% if d.url %}
      <a class="doc-card is-live" href="{{ d.url }}" target="_blank" rel="noopener">
      {% else %}
      <span class="doc-card is-pending">
      {% endif %}
        <span class="doc-icon" style="{% if d.color %}--accent-color: {{ d.color }};{% endif %}">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <span class="doc-body">
          <span class="doc-title">{{ d.label }}</span>
          <span class="doc-sub">{% if d.url %}Download PDF{% else %}Link pending{% endif %}</span>
          {% if d.description %}<span class="doc-desc">{{ d.description }}</span>{% endif %}
        </span>
      {% if d.url %}</a>{% else %}</span>{% endif %}
      {% endfor %}
    </div>
    {% endif %}
  </div>
</section>
{% endif %}

<section>
  <div class="wrap" style="text-align:center;">
    <a class="btn" href="/{{ region }}/">&larr; Back to Circular Steel {{ region | upper }}</a>
  </div>
</section>
