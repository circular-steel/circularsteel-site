<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>{{ title }} | {{ site.name }}</title>
<meta name="description" content="{{ description or site.tagline }}">
<link rel="icon" type="image/png" href="/images/circular-steel-logo.png">
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@400;500;600;700&family=Source+Serif+4:opsz,wght@8..60,400;8..60,600&display=swap" rel="stylesheet">
<style>
  :root {
    --navy: #002c6a;
    --navy-deep: #001a44;
    --cyan: #00b3e0;
    --cyan-soft: #eaf9ff;
    --accent: #ff2600;
    --ink: #0d1b33;
    --muted: #5a6a85;
    --line: #e3e9f2;
    --paper: #ffffff;
    --wash: #f6faff;
    --heading-font: "Oswald", -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    --body-font: "Source Serif 4", Georgia, "Times New Roman", serif;
  }
  * { box-sizing: border-box; }
  body {
    margin: 0;
    font-family: var(--heading-font);
    color: var(--ink);
    background: var(--paper);
    line-height: 1.65;
  }
  h1, h2, h3, .brand span { font-family: var(--heading-font); }
  p { font-family: var(--body-font); }
  a { color: var(--navy); }
  .wrap { max-width: 1120px; margin: 0 auto; padding: 0 24px; }

  .promo-banner { background: var(--navy); color: #fff; }
  .promo-banner .wrap {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 14px;
    flex-wrap: wrap;
    padding: 10px 24px;
    font-size: 14px;
    font-weight: 600;
    text-align: center;
    position: relative;
  }
  .promo-banner a { color: #fff; text-decoration: underline; text-underline-offset: 2px; flex-shrink: 0; }
  .promo-banner .promo-close {
    position: absolute;
    right: 16px; top: 50%; transform: translateY(-50%);
    background: none; border: none; color: rgba(255,255,255,0.7);
    font-size: 20px; line-height: 1; cursor: pointer; padding: 4px;
  }
  .promo-banner .promo-close:hover { color: #fff; }

  header.site {
    border-bottom: 1px solid var(--line);
    position: sticky;
    top: 0;
    background: rgba(255,255,255,0.92);
    backdrop-filter: blur(8px);
    z-index: 10;
  }
  header.site .wrap {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-top: 14px;
    padding-bottom: 14px;
  }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; }
  .brand img { height: 36px; width: auto; }
  .brand span { font-weight: 700; color: var(--navy); font-size: 18px; letter-spacing: 0.01em; text-transform: uppercase; }
  nav.main { display: flex; gap: 4px; flex-wrap: wrap; }
  nav.main a {
    text-decoration: none;
    color: var(--navy);
    font-weight: 600;
    font-size: 14px;
    padding: 8px 14px;
    border-radius: 999px;
  }
  nav.main a:hover { background: var(--wash); }
  nav.main a.current { background: var(--navy); color: #fff; }

  .nav-toggle {
    display: none;
    align-items: center;
    justify-content: center;
    width: 40px; height: 40px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
    background: #fff;
    cursor: pointer;
    flex-shrink: 0;
  }
  .nav-toggle svg { display: block; }
  .nav-toggle .icon-close { display: none; }
  .nav-toggle[aria-expanded="true"] .icon-open { display: none; }
  .nav-toggle[aria-expanded="true"] .icon-close { display: block; }

  @media (max-width: 760px) {
    header.site .wrap { flex-wrap: nowrap; }
    .nav-toggle { display: flex; }
    nav.main {
      display: none;
      flex-direction: column;
      gap: 2px;
      position: fixed;
      top: 65px; left: 0; right: 0;
      max-height: calc(100vh - 65px);
      overflow-y: auto;
      background: #fff;
      border-top: 1px solid var(--line);
      border-bottom: 1px solid var(--line);
      padding: 10px 24px 18px;
      box-shadow: 0 16px 32px -20px rgba(0,44,106,0.25);
    }
    nav.main.is-open { display: flex; }
    nav.main a { padding: 13px 14px; font-size: 15px; border-radius: 10px; }
  }

  main { min-height: 60vh; overflow-x: clip; }

  .hero {
    position: relative;
    background: #f7fbfe;
    padding: 76px 0 72px;
    overflow: hidden;
    text-align: center;
  }
  .hero.hero-photo {
    background-image: linear-gradient(100deg, rgba(0,15,40,0.28), rgba(0,15,40,0.05) 55%), url('/images/hero-bg.jpg');
    background-size: cover;
    background-position: left center;
  }
  .hero.hero-photo h1,
  .hero.hero-photo p.lede { color: #fff; }
  .hero.hero-photo p.lede { color: rgba(255,255,255,0.88); }
  .hero .wrap { position: relative; z-index: 1; }
  .hero-grid {
    display: grid;
    grid-template-columns: 1.05fr 0.95fr;
    gap: 48px;
    align-items: center;
  }
  .hero-grid .hero-copy {
    text-align: left;
  }
  .hero-grid .hero-copy p.lede { margin: 0; max-width: 500px; }
  .hero-grid .hero-copy .btn-row { justify-content: flex-start; }
  .hero h1 {
    font-weight: 700;
    font-size: clamp(34px, 4.6vw, 56px);
    color: var(--navy);
    margin: 0 0 18px;
    letter-spacing: 0;
    line-height: 1.05;
    text-transform: uppercase;
  }
  .hero p.lede {
    font-size: 19px;
    color: var(--muted);
    max-width: 620px;
    margin: 0 auto;
  }
  @media (max-width: 860px) {
    .hero-grid { grid-template-columns: 1fr; }
    .hero-grid .hero-copy { text-align: center; }
    .hero-grid .hero-copy p.lede { margin: 0 auto; }
    .hero-grid .hero-copy .btn-row { justify-content: center; }
  }

  .media-frame {
    position: relative;
    border-radius: 20px;
    overflow: hidden;
    box-shadow: 0 24px 48px -24px rgba(0,44,106,0.35);
    border: 1px solid var(--line);
    background: var(--navy);
  }
  .media-frame img { display: block; width: 100%; height: 100%; object-fit: cover; }
  .media-frame.video { aspect-ratio: 16 / 10; }
  .media-frame.video iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .media-frame .caption {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 14px 18px;
    background: linear-gradient(180deg, transparent, rgba(0,20,50,0.75));
    color: #fff; font-size: 13px; font-weight: 600;
  }
  .media-frame .play-btn {
    position: absolute; top: 50%; left: 50%;
    transform: translate(-50%, -50%);
    width: 64px; height: 64px;
    border-radius: 50%;
    background: rgba(0,44,106,0.85);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .media-frame:hover .play-btn { transform: translate(-50%, -50%) scale(1.08); background: var(--cyan); }
  .media-frame .play-btn svg { margin-left: 3px; }

  section { padding: 56px 0; }
  section.wash { background: var(--wash); }
  section.dark {
    background: var(--navy);
    color: #fff;
  }
  section.dark .stat .number { color: #fff; }
  section.dark .stat .label { color: rgba(255,255,255,0.7); }
  section.dark h2.section-title { color: #fff; }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 44px;
    align-items: center;
  }
  .split.reverse .split-media { order: 2; }
  @media (max-width: 860px) {
    .split { grid-template-columns: 1fr; }
    .split.reverse .split-media { order: 0; }
  }

  .gallery {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    grid-auto-rows: 130px;
    grid-auto-flow: dense;
    gap: 14px;
  }
  .gallery a { display: block; border-radius: 14px; overflow: hidden; position: relative; }
  .gallery img { width: 100%; height: 100%; object-fit: cover; display: block; transition: transform 0.35s ease; }
  .gallery a:hover img { transform: scale(1.06); }
  .gallery .g-a { grid-column: span 2; grid-row: span 2; }
  .gallery .g-b { grid-column: span 2; grid-row: span 1; }
  @media (max-width: 860px) {
    .gallery { grid-template-columns: repeat(2, 1fr); grid-auto-rows: 130px; }
    .gallery .g-a { grid-column: span 2; grid-row: span 2; }
    .gallery .g-b { grid-column: span 2; grid-row: span 1; }
  }
  h2.section-title {
    font-weight: 600;
    color: var(--navy);
    font-size: 29px;
    margin: 0 0 30px;
    letter-spacing: 0;
  }
  h2.section-title .kicker {
    display: block;
    font-family: var(--body-font);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    color: var(--cyan);
    margin-bottom: 8px;
  }

  .grid-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 24px; }
  .grid-3 { display: grid; grid-template-columns: repeat(3, 1fr); gap: 20px; }
  .grid-4 { display: grid; grid-template-columns: repeat(4, 1fr); gap: 20px; }
  @media (max-width: 720px) {
    .grid-2, .grid-3, .grid-4 { grid-template-columns: 1fr; }
  }

  .card {
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    padding: 26px;
    height: 100%;
    box-sizing: border-box;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .card h3 { margin: 0 0 8px; color: var(--navy); font-size: 18px; font-weight: 700; }
  .card .meta { font-size: 13px; color: var(--cyan); font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; margin-bottom: 8px; }
  .card p { color: var(--muted); margin: 0; font-size: 15px; }
  a.card-link { text-decoration: none; color: inherit; display: flex; }
  a.card-link:hover .card { border-color: var(--cyan); transform: translateY(-2px); box-shadow: 0 12px 24px -16px rgba(0,44,106,0.35); }

  /* Tier-coloured sponsor cards: bold edge + a light wash of the same
     colour behind the (white) logo box, so the tile reads as belonging
     to that tier without the logo ever sitting on a coloured background. */
  .card.tier-edge {
    border-top: 6px solid var(--tier-color, var(--muted));
    background: color-mix(in srgb, var(--tier-color, var(--muted)) 7%, white);
    display: flex;
    flex-direction: column;
    width: 100%;
  }

  .post-tile {
    display: block;
    text-decoration: none;
    color: inherit;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 16px;
    overflow: hidden;
    box-shadow: 0 14px 28px -18px rgba(0,10,30,0.45);
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .post-tile:hover { border-color: var(--cyan); transform: translateY(-2px); box-shadow: 0 16px 30px -14px rgba(0,10,30,0.5); }
  .post-tile .thumb { aspect-ratio: 16/9; background: var(--wash); overflow: hidden; }
  .post-tile .thumb img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .post-tile .body { padding: 20px 22px; }
  .post-tile .meta { font-size: 12px; font-weight: 700; text-transform: uppercase; letter-spacing: 0.06em; color: var(--cyan); margin-bottom: 8px; }
  .post-tile h3 { margin: 0 0 8px; color: var(--navy); font-size: 17px; font-weight: 700; }
  .post-tile p { margin: 0; color: var(--muted); font-size: 14px; }
  .tiles-sm .post-tile .body { padding: 14px 16px; }
  .tiles-sm .post-tile .meta { font-size: 10.5px; margin-bottom: 5px; }
  .tiles-sm .post-tile h3 { font-size: 15px; margin-bottom: 5px; line-height: 1.3; }
  .tiles-sm .post-tile p { font-size: 13px; }

  .event-feature {
    display: grid;
    grid-template-columns: 1fr 1fr;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 20px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, box-shadow 0.15s ease;
  }
  .event-feature:hover { border-color: var(--cyan); box-shadow: 0 16px 32px -20px rgba(0,44,106,0.35); }
  .event-feature .ef-media { min-height: 220px; background: var(--navy); }
  .event-feature .ef-media img { width: 100%; height: 100%; object-fit: cover; display: block; }
  .event-feature .ef-body { padding: 28px 30px; display: flex; flex-direction: column; justify-content: center; }
  .event-feature h3 { font-size: 21px; margin: 10px 0 10px; color: var(--navy); }
  .event-feature p { color: var(--muted); font-size: 15px; margin: 0; }
  @media (max-width: 720px) {
    .event-feature { grid-template-columns: 1fr; }
    .event-feature .ef-media { min-height: 180px; }
  }

  .archive-list { border-top: 1px solid var(--line); }
  .archive-row {
    display: flex;
    align-items: baseline;
    gap: 20px;
    padding: 18px 4px;
    border-bottom: 1px solid var(--line);
    text-decoration: none;
    color: inherit;
    transition: padding-left 0.15s ease;
  }
  .archive-row:hover { padding-left: 10px; color: var(--navy); }
  .archive-row .yr { font-family: var(--heading-font); font-weight: 700; color: var(--cyan); font-size: 15px; width: 46px; flex-shrink: 0; }
  .archive-row .as { font-family: var(--body-font); }
  .archive-row .at { font-weight: 700; color: var(--navy); flex: 1; }
  .archive-row .as { color: var(--muted); font-size: 14px; display: none; }
  @media (min-width: 640px) {
    .archive-row .as { display: block; flex: 2; }
  }

  .stat { text-align: center; }
  .stat .number { font-family: var(--heading-font); font-weight: 700; font-size: 42px; color: var(--navy); line-height: 1; }
  .stat .label { margin-top: 8px; font-size: 14px; color: var(--muted); }

  .logo-strip { display: flex; flex-wrap: wrap; gap: 16px; justify-content: center; align-items: center; }
  .logo-tile {
    display: flex;
    align-items: center;
    justify-content: center;
    height: 76px;
    width: 160px;
    padding: 14px 22px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    filter: grayscale(1);
    opacity: 0.65;
    transition: filter 0.2s ease, opacity 0.2s ease, border-color 0.2s ease;
  }
  .logo-tile:hover { filter: grayscale(0); opacity: 1; border-color: var(--cyan); }
  .logo-tile img { max-width: 100%; max-height: 100%; object-fit: contain; }
  .logo-tile.large { width: 220px; height: 100px; filter: none; opacity: 1; }

  .tag {
    display: inline-block;
    font-size: 11px;
    font-weight: 700;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    padding: 5px 12px;
    border-radius: 999px;
    background: #f0fbff;
    color: var(--cyan);
    border: 1px solid #cdeef9;
  }
  .tag.status-past { background: var(--wash); color: var(--muted); border-color: var(--line); }

  /* Tier colour comes from the CMS-managed Tiers collection via the
     --tier-color custom property, set inline per element - so a tier
     Steve adds later works with zero code changes. */
  .tag.tier-dynamic {
    background: var(--tier-color, var(--muted));
    color: #fff;
    border-color: var(--tier-color, var(--muted));
  }
  .card.tier-edge { border-top: 6px solid var(--tier-color, var(--muted)); }

  .btn {
    display: inline-block;
    text-decoration: none;
    font-weight: 700;
    font-size: 14px;
    padding: 13px 26px;
    border-radius: 999px;
    border: 1.5px solid var(--navy);
    color: var(--navy);
    transition: background 0.15s ease, color 0.15s ease, transform 0.15s ease;
  }
  .btn:hover { background: var(--navy); color: #fff; }
  .btn.solid { background: var(--navy); color: #fff; }
  .btn.solid:hover { background: var(--navy-deep); }
  .btn.on-dark { border-color: #fff; color: #fff; }
  .btn.on-dark:hover { background: #fff; color: var(--navy); }
  .btn.on-dark.solid-white { background: #fff; color: var(--navy); }
  .btn.on-dark.solid-white:hover { background: var(--cyan-soft); }
  .btn:active { transform: scale(0.98); }

  .btn-row { display: flex; gap: 12px; flex-wrap: wrap; justify-content: center; margin-top: 30px; }

  table.docs { width: 100%; border-collapse: collapse; font-size: 15px; }
  table.docs td { padding: 10px 0; border-bottom: 1px solid var(--line); }
  table.docs td:last-child { text-align: right; }

  .doc-grid { display: grid; grid-template-columns: repeat(2, 1fr); gap: 14px; }
  @media (max-width: 720px) { .doc-grid { grid-template-columns: 1fr; } }
  .doc-card {
    display: flex;
    align-items: flex-start;
    gap: 14px;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 14px;
    padding: 18px 20px;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .doc-card.is-live:hover { border-color: var(--cyan); transform: translateY(-2px); box-shadow: 0 10px 20px -14px rgba(0,44,106,0.35); }
  .doc-card.is-pending { cursor: default; opacity: 0.6; }
  .doc-card .doc-icon {
    flex-shrink: 0;
    width: 38px; height: 38px;
    border-radius: 10px;
    background: var(--cyan-soft);
    color: var(--navy);
    display: flex; align-items: center; justify-content: center;
  }
  .doc-card.is-pending .doc-icon { background: var(--wash); color: var(--muted); }
  .doc-card .doc-title { font-weight: 700; color: var(--navy); font-size: 14.5px; line-height: 1.35; }
  .doc-card.is-pending .doc-title { color: var(--muted); }
  .doc-card .doc-sub { font-size: 12.5px; color: var(--muted); margin-top: 3px; }

  .doc-tile-grid { display: grid; grid-template-columns: repeat(5, 1fr); gap: 10px; }
  @media (max-width: 900px) { .doc-tile-grid { grid-template-columns: repeat(3, 1fr); } }
  @media (max-width: 560px) { .doc-tile-grid { grid-template-columns: repeat(2, 1fr); } }
  .doc-tile {
    display: block;
    background: #fff;
    border: 1px solid var(--line);
    border-radius: 10px;
    overflow: hidden;
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s ease, transform 0.15s ease, box-shadow 0.15s ease;
  }
  .doc-tile.is-live:hover { border-color: var(--cyan); transform: translateY(-2px); box-shadow: 0 10px 18px -12px rgba(0,44,106,0.35); }
  .doc-tile.is-pending { opacity: 0.55; }
  .doc-tile .doc-tile-head {
    aspect-ratio: 4 / 3;
    display: flex; align-items: center; justify-content: center;
    background: color-mix(in srgb, var(--accent-color, var(--navy)) 14%, white);
  }
  .doc-tile .doc-tile-head svg { color: var(--accent-color, var(--navy)); opacity: 0.85; width: 18px; height: 18px; }
  .doc-tile.is-pending .doc-tile-head { background: var(--wash) !important; }
  .doc-tile.is-pending .doc-tile-head svg { color: var(--muted); }
  .doc-tile .doc-tile-body { padding: 8px 9px; }
  .doc-tile .doc-title { display: block; font-weight: 700; color: var(--navy); font-size: 11.5px; line-height: 1.3; margin-bottom: 2px; }
  .doc-tile.is-pending .doc-title { color: var(--muted); }
  .doc-tile .doc-sub { display: block; font-size: 10px; color: var(--muted); }

  .video-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 14px; }
  @media (max-width: 860px) { .video-grid { grid-template-columns: repeat(2, 1fr); } }
  @media (max-width: 560px) { .video-grid { grid-template-columns: 1fr; } }
  .video-tile {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: 12px;
    overflow: hidden;
    background-size: cover;
    background-position: center;
    background-color: var(--navy);
    cursor: pointer;
  }
  .video-tile iframe { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .video-tile .play-btn.small {
    position: absolute; top: 50%; left: 50%; transform: translate(-50%, -50%);
    width: 42px; height: 42px; border-radius: 50%;
    background: rgba(0,44,106,0.85);
    display: flex; align-items: center; justify-content: center;
    transition: transform 0.15s ease, background 0.15s ease;
  }
  .video-tile:hover .play-btn.small { transform: translate(-50%, -50%) scale(1.1); background: var(--cyan); }
  .video-tile .play-btn.small svg { margin-left: 2px; }
  .video-tile .video-label {
    position: absolute; left: 0; right: 0; bottom: 0;
    padding: 8px 10px 7px;
    background: linear-gradient(180deg, transparent, rgba(0,20,50,0.85));
    color: #fff; font-size: 12px; font-weight: 600; line-height: 1.3;
  }

  form.contact-form { display: grid; gap: 14px; max-width: 480px; }
  form.contact-form input, form.contact-form textarea {
    font: inherit;
    padding: 12px 14px;
    border: 1.5px solid var(--line);
    border-radius: 10px;
  }
  form.contact-form label { font-size: 13px; font-weight: 600; color: var(--muted); display: block; margin-bottom: 4px; }
  form.contact-form button {
    font: inherit;
    font-weight: 700;
    background: var(--navy);
    color: #fff;
    border: none;
    padding: 13px 26px;
    border-radius: 999px;
    cursor: pointer;
    justify-self: start;
  }

  footer.site {
    border-top: 1px solid var(--line);
    padding: 32px 0;
    margin-top: 40px;
  }
  footer.site .wrap { display: flex; justify-content: space-between; flex-wrap: wrap; gap: 12px; align-items: center; }
  footer.site .links { display: flex; gap: 18px; flex-wrap: wrap; }
  footer.site a { color: var(--muted); text-decoration: none; font-size: 13px; }
  footer.site a:hover { color: var(--navy); }
  footer.site .copy { font-size: 13px; color: var(--muted); }

  .prose { max-width: 720px; margin: 0 auto; }
  .prose h2 { color: var(--navy); font-size: 23px; font-weight: 600; margin-top: 36px; }
  .prose p { color: var(--ink); }
</style>
</head>
<body>
  {% set activeBanner = null %}
  {% if region == "uk" and banner.uk.enabled %}{% set activeBanner = banner.uk %}
  {% elif region == "usa" and banner.usa.enabled %}{% set activeBanner = banner.usa %}
  {% elif banner.global.enabled %}{% set activeBanner = banner.global %}
  {% endif %}
  {% if activeBanner %}
  <div class="promo-banner">
    <div class="wrap">
      <span>{{ activeBanner.text }}</span>
      {% if activeBanner.linkUrl %}<a href="{{ activeBanner.linkUrl }}">{{ activeBanner.linkLabel or "Find out more" }} &rarr;</a>{% endif %}
      <button type="button" class="promo-close" aria-label="Dismiss" onclick="this.closest('.promo-banner').remove();">&times;</button>
    </div>
  </div>
  {% endif %}
  <header class="site">
    <div class="wrap">
      <a class="brand" href="/">
        <img src="/images/circular-steel-logo.png" alt="Circular Steel">
        <span>Circular Steel</span>
      </a>
      <button class="nav-toggle" id="nav-toggle" aria-label="Menu" aria-expanded="false" aria-controls="site-nav">
        <svg class="icon-open" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#002c6a" stroke-width="2" stroke-linecap="round"><path d="M3 6h18M3 12h18M3 18h18"/></svg>
        <svg class="icon-close" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="#002c6a" stroke-width="2" stroke-linecap="round"><path d="M6 6l12 12M18 6L6 18"/></svg>
      </button>
      <nav class="main" id="site-nav">
        {% for item in site.nav %}
          <a href="{{ item.url }}" {% if page.url | isActiveNav(item.url) %}class="current"{% endif %}>{{ item.label }}</a>
        {% endfor %}
      </nav>
    </div>
  </header>
  <script>
    (function () {
      var toggle = document.getElementById('nav-toggle');
      var nav = document.getElementById('site-nav');
      toggle.addEventListener('click', function () {
        var isOpen = nav.classList.toggle('is-open');
        toggle.setAttribute('aria-expanded', isOpen ? 'true' : 'false');
      });
      nav.querySelectorAll('a').forEach(function (link) {
        link.addEventListener('click', function () {
          nav.classList.remove('is-open');
          toggle.setAttribute('aria-expanded', 'false');
        });
      });
    })();
  </script>

  <main>
    {{ content | safe }}
  </main>

  <footer class="site">
    <div class="wrap">
      <div class="copy">&copy; {{ currentYear }} Circular Steel</div>
      <div class="links">
        <a href="/contact/">Contact</a>
        <a href="{{ site.substack }}" target="_blank" rel="noopener">Newsletter</a>
        <a href="{{ site.linkedinPage }}" target="_blank" rel="noopener">LinkedIn</a>
        <a href="{{ site.linkedinGroup }}" target="_blank" rel="noopener">LinkedIn Group</a>
      </div>
    </div>
  </footer>
</body>
</html>
