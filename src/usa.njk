---
layout: base.njk
title: Circular Steel USA
description: Supporting the next frontier of steel reuse across North America.
permalink: /usa/
region: usa
---
{% from "sponsor-grid.njk" import sponsorGrid %}
{% from "logo-marquee.njk" import logoMarquee %}
<section class="hero{% if pages.usa.heroImage %} hero-photo hero-center{% endif %}" style="padding-bottom:0;{% if pages.usa.heroImage %} --hero-img: url('{{ pages.usa.heroImage }}'); --hero-pos: center;{% endif %}">
  <div class="wrap">
    <h1>{{ pages.usa.heroTitle }}</h1>
    <p class="lede">{{ pages.usa.heroLede }}</p>
  </div>
</section>

{% set usaUpcoming = collections.events | byRegion("usa") | firstUpcoming %}
{% if usaUpcoming %}
<section>
  <div class="wrap" style="text-align:center;">
    <div class="card dark" style="display:inline-block; text-align:left; max-width:520px;">
      <div class="meta">Next event</div>
      <h3>{{ usaUpcoming.data.title }}</h3>
      <p>{{ usaUpcoming.data.date | eventDate }}{% if usaUpcoming.data.time %}, {{ usaUpcoming.data.time }}{% endif %} &middot; {{ usaUpcoming.data.venue }}. {{ usaUpcoming.data.summary }}</p>
      <p style="margin-top:14px; display:flex; gap:12px; flex-wrap:wrap;">
        <a class="btn on-dark solid-white" href="/contact/">Get in touch</a>
        <a class="btn on-dark" href="{{ usaUpcoming.url }}">View event page</a>
      </p>
    </div>
  </div>
</section>
{% endif %}

<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Focus</span>Connecting global expertise</h2>
    <p class="prose" style="margin-bottom:20px;">{{ pages.usa.focusIntro }}</p>
    <div class="grid-2">
      <div class="card"><p>US project leaders and asset owners</p></div>
      <div class="card"><p>UK practitioners sharing proven experience</p></div>
      <div class="card"><p>Engineers, fabricators and demolition specialists</p></div>
      <div class="card"><p>Policy leaders and sustainability experts</p></div>
    </div>
    <p class="prose" style="margin-top:28px;">{{ pages.usa.closingText }}</p>
  </div>
</section>

{% set usaPartners = programmePartners.usa | resolveSponsors(collections.sponsors, collections.tiers) %}
{% if usaPartners.length %}
<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Backed by</span>Our Sponsors</h2>
    <div class="grid-3">
      {{ sponsorGrid(usaPartners, collections.tiers) }}
    </div>
  </div>
</section>
{% endif %}

{% set usaEvents = collections.events | byRegion("usa") | excludeUpcoming %}
<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Most recent</span>Previous USA events</h2>
    <div class="grid-2">
      {% for event in usaEvents %}
        {% if loop.index0 < 2 %}
        <a class="event-feature" href="{{ event.url }}">
          <div class="ef-media">
            {% if event.data.image %}<img src="{{ event.data.image }}" alt="{{ event.data.title }}">{% endif %}
          </div>
          <div class="ef-body">
            <span class="tag status-past">{{ event.data.year }}</span>
            <h3>{{ event.data.title }}</h3>
            <p>{{ event.data.summary }}</p>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if usaEvents.length > 2 %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Archive</span>Earlier USA events</h2>
    <div class="archive-list">
      {% for event in usaEvents %}
        {% if loop.index0 >= 2 %}
        <a class="archive-row" href="{{ event.url }}">
          <span class="yr">{{ event.data.year }}</span>
          <span class="at">{{ event.data.title }}</span>
          <span class="as">{{ event.data.summary }}</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set usaLogoSponsors = collections.sponsors | sponsorsForRegion(collections.events, "usa") %}
{% if usaLogoSponsors.length %}
<section>
  <div class="wrap" style="text-align:center;">
    <h2 class="section-title" style="text-align:center;">
      <span class="kicker">Community</span>
      Sponsors across the USA supply chain
    </h2>
    {{ logoMarquee(usaLogoSponsors, 1) }}
  </div>
</section>
{% endif %}
