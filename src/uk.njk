---
layout: base.njk
title: Circular Steel UK
description: The flagship forum for steel reuse. Held annually in London.
permalink: /uk/
region: uk
---
{% from "sponsor-grid.njk" import sponsorGrid %}
{% from "logo-marquee.njk" import logoMarquee %}
<section class="hero{% if pages.uk.heroImage %} hero-photo hero-center{% endif %}" style="padding-bottom:0;{% if pages.uk.heroImage %} --hero-img: url('{{ pages.uk.heroImage }}'); --hero-pos: center;{% endif %}">
  <div class="wrap">
    <h1>{{ pages.uk.heroTitle }}</h1>
    <p class="lede">{{ pages.uk.heroLede }}</p>
  </div>
</section>

{% set ukUpcoming = collections.events | byRegion("uk") | firstUpcoming %}
{% if ukUpcoming %}
<section>
  <div class="wrap" style="text-align:center;">
    <div class="card dark" style="display:inline-block; text-align:left; max-width:520px;">
      <div class="meta">Next event</div>
      <h3>{{ ukUpcoming.data.title }}</h3>
      <p>{{ ukUpcoming.data.date | eventDate }}{% if ukUpcoming.data.time %}, {{ ukUpcoming.data.time }}{% endif %} &middot; {{ ukUpcoming.data.venue }}. {{ ukUpcoming.data.summary }}</p>
      <p style="margin-top:14px; display:flex; gap:12px; flex-wrap:wrap;">
        <a class="btn on-dark solid-white" href="/contact/">Get in touch</a>
        <a class="btn on-dark" href="{{ ukUpcoming.url }}">View event page</a>
      </p>
    </div>
  </div>
</section>
{% endif %}

<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Focus</span>Where strategy meets delivery</h2>
    <p class="prose" style="margin-bottom:20px;">{{ pages.uk.focusIntro }}</p>
    <div class="grid-3">
      <div class="card"><p>Real project case studies</p></div>
      <div class="card"><p>Deconstruction, testing and certification</p></div>
      <div class="card"><p>Supply chain readiness</p></div>
      <div class="card"><p>Commercials and risk</p></div>
      <div class="card"><p>Standards, policy and planning drivers</p></div>
    </div>
    <p class="prose" style="margin-top:28px;"><strong>Who attends.</strong> {{ pages.uk.whoAttends }}</p>
  </div>
</section>

{% set ukPartners = programmePartners.uk | resolveSponsors(collections.sponsors, collections.tiers) %}
{% if ukPartners.length %}
<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Backed by</span>Our Sponsors</h2>
    <div class="grid-3">
      {{ sponsorGrid(ukPartners, collections.tiers) }}
    </div>
  </div>
</section>
{% endif %}

{% set ukEvents = collections.events | byRegion("uk") | excludeUpcoming %}
<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Most recent</span>Previous UK events</h2>
    <div class="grid-2">
      {% for event in ukEvents %}
        {% if loop.index0 < 2 %}
        <a class="event-feature" href="{{ event.url }}">
          <div class="ef-media">
            {% if event.data.image %}<img src="{{ event.data.image }}" alt="{{ event.data.title }}">{% endif %}
          </div>
          <div class="ef-body">
            <span class="tag status-past">{{ event.data.year }}</span>
            <h3>{{ event.data.title }}</h3>
            <p>{{ event.data.summary }}</p>
          </div>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>

{% if ukEvents.length > 2 %}
<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Archive</span>Earlier UK events</h2>
    <div class="archive-list">
      {% for event in ukEvents %}
        {% if loop.index0 >= 2 %}
        <a class="archive-row" href="{{ event.url }}">
          <span class="yr">{{ event.data.year }}</span>
          <span class="at">{{ event.data.title }}</span>
          <span class="as">{{ event.data.summary }}</span>
        </a>
        {% endif %}
      {% endfor %}
    </div>
  </div>
</section>
{% endif %}

{% set ukLogoSponsors = collections.sponsors | sponsorsForRegion(collections.events, "uk") %}
{% if ukLogoSponsors.length %}
<section>
  <div class="wrap" style="text-align:center;">
    <h2 class="section-title" style="text-align:center;">
      <span class="kicker">Community</span>
      Sponsors across the UK supply chain
    </h2>
    {{ logoMarquee(ukLogoSponsors) }}
  </div>
</section>
{% endif %}
