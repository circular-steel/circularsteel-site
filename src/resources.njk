---
layout: base.njk
title: Resources
description: Organisations and key documents on structural steel reuse.
permalink: /resources/
---
<section class="hero" style="padding-bottom:0;">
  <div class="wrap">
    <h1>{{ pages.resources.heroTitle }}</h1>
    <p class="lede">{{ pages.resources.heroLede }}</p>
  </div>
</section>

<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Organisations</span>Who's driving the standards</h2>
    <div class="grid-2">
      <div class="card">
        <h3>BCSA</h3>
        <p style="margin-bottom:8px;">British Constructional Steelwork Association</p>
        <p>The trade body for UK &amp; Irish Steelwork Contractors and the wider structural steelwork supply chain.</p>
        <p style="margin-top:14px;"><a href="https://www.steelconstruction.org/" target="_blank" rel="noopener">steelconstruction.org &rarr;</a></p>
      </div>
      <div class="card">
        <h3>SCI</h3>
        <p style="margin-bottom:8px;">Steel Construction Institute</p>
        <p>A trusted, independent source of information and engineering expertise globally for over 30 years, and the leading independent provider of technical expertise and best practice to the steel construction sector.</p>
        <p style="margin-top:14px;"><a href="https://www.steel-sci.com/" target="_blank" rel="noopener">steel-sci.com &rarr;</a></p>
      </div>
    </div>
  </div>
</section>

<section class="wash">
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Reading list</span>Key documents</h2>
    <div class="doc-grid">
      {% set keyDocs = [
        { title: "BCSA 2050 Decarbonisation Roadmap", source: "steelconstruction.org", url: "https://www.steelconstruction.org/" },
        { title: "NSSS Annex J: Sustainability Specification (2022)", source: "steelconstruction.org", url: "https://www.steelconstruction.org/" },
        { title: "SCI P427 — Structural Steel Reuse (2019)", source: "steel-sci.com", url: "https://www.steel-sci.com/" },
        { title: "SCI P440 — Structural Steel Reuse Pre-1970 (2023)", source: "steel-sci.com", url: "https://www.steel-sci.com/" },
        { title: "BCSA — Model Specification for the Purchase of Reclaimed Steel Sections (2022)", source: "steelconstruction.org", url: "https://www.steelconstruction.org/" },
        { title: "IStructE — Appraisal of Existing Structures, 3rd Ed (2010)", source: "istructe.org", url: "https://www.istructe.org/" }
      ] %}
      {% for doc in keyDocs %}
      <a class="doc-card is-live" href="{{ doc.url }}" target="_blank" rel="noopener">
        <span class="doc-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <span>
          <span class="doc-title">{{ doc.title }}</span>
          <span class="doc-sub">via {{ doc.source }}</span>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>

<section>
  <div class="wrap">
    <h2 class="section-title"><span class="kicker">Further reading</span>Useful links</h2>
    <div class="doc-grid">
      {% set furtherDocs = [
        { title: "IStructE — Circular Economy and Reuse: Guidance for Designers (2023)", source: "istructe.org", url: "https://www.istructe.org/" },
        { title: "PROGRESS — Provisions for a Greater Reuse of Steel Structures (2020)", source: "steelconstruct.com", url: "https://www.steelconstruct.com/" }
      ] %}
      {% for doc in furtherDocs %}
      <a class="doc-card is-live" href="{{ doc.url }}" target="_blank" rel="noopener">
        <span class="doc-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><path d="M14 2v6h6"/></svg>
        </span>
        <span>
          <span class="doc-title">{{ doc.title }}</span>
          <span class="doc-sub">via {{ doc.source }}</span>
        </span>
      </a>
      {% endfor %}
    </div>
  </div>
</section>
